# DeepSeek/OpenAI 兼容 API 配置（主推理模型）
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# JEV 决策模型（本地 Ollama，阶段三启用）
JEV_BASE_URL=http://localhost:11434/v1
JEV_MODEL=qwen2.5:7b
JEV_API_KEY=ollama

# 嵌入模型配置
# 优先使用 Ollama BGE-M3；无 Ollama 时自动降级到 sentence-transformers
EMBEDDING_PROVIDER=ollama          # ollama | sentence_transformers
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=ollama
# sentence-transformers 降级模型名
EMBEDDING_FALLBACK_MODEL=all-MiniLM-L6-v2

# Qdrant 向量数据库（Docker 或本地内存模式）
QDRANT_URL=                        # 留空则使用本地内存模式（数据不持久化）
QDRANT_API_KEY=

# Semantic Scholar API（可选，留空走公开端点）
S2_API_KEY=

# 数据与日志目录
DATA_DIR=./data
LOG_DIR=./logs
OUTPUT_DIR=./outputs

# 研究默认参数
DEFAULT_DEPTH=standard             # basic | standard | deep
DEFAULT_MAX_PAPERS=20
